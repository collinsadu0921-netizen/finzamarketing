# Copy to .env.local and fill in values (never commit .env.local).
# cp .env.example .env.local   (macOS/Linux)
# copy .env.example .env.local (Windows)

# ── Supabase (blog admin) ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Contact + plan-fit walkthrough (/api/contact) ───────────────────────────
# At least ONE delivery channel is required or submissions return 500.

# Optional: Zapier, Make, Slack incoming webhook, etc.
CONTACT_WEBHOOK_URL=

# Optional: email notifications via Resend (requires both vars below)
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=

# Demo page (/api/demo-submit) — optional
DEMO_WEBHOOK_URL=
# Falls back to CONTACT_NOTIFY_EMAIL for /api/contact if unset
DEMO_NOTIFY_EMAIL=
